        "font_size": 44,
        "font_weight": "bold",
        "color": "gold",
        "alignment": "center",
        "font": "Microsoft YaHei"
      }
    },
    {
      "id": "subtitle",
      "type": "text",
      "source": "content",
      "position": { "left": 1.5, "top": 4.0, "width": 10.3, "height": 0.8 },
      "style": {
        "font_size": 24,
        "color": "white",
        "alignment": "center",
        "font": "Microsoft YaHei"
      }
    },
    {
      "id": "date",
      "type": "text",
      "source": "auto",
      "position": { "left": 1.5, "top": 5.2, "width": 10.3, "height": 0.5 },
      "style": {
        "font_size": 18,
        "color": "white",
        "alignment": "center",
        "font": "Microsoft YaHei",
        "auto_type": "date"
      }
    }
  ],
  "decorations": [
    { "type": "footer_bar", "layer": "bottom", "color": "gold", "height": 0.11 },
    { "type": "branding", "layer": "top", "text": "CONFIDENTIAL", "position": "top_right", "color": "text_light", "font_size": 9 }
